# Logging
log_info() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

log_warn() {
    echo -e "${YELLOW}[AVISO]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERRO]${NC} $1"
}

log_step() {
    echo -e "${BLUE}[=>]${NC} $1"
}

# Verificar se é Ubuntu/Debian
check_os() {
    if [ -f /etc/os-release ]; then
        . /etc/os-release
        if [[ "$ID" != "ubuntu" && "$ID" != "debian" && "$ID_LIKE" != *"ubuntu"* && "$ID_LIKE" != *"debian"* ]]; then
            log_warn "Sistema não é Ubuntu/Debian. Algumas funcionalidades podem não funcionar."
        fi
    fi
}

# Verificar dependências do sistema
check_system_deps() {
    local missing=()

    # Python 3
    if ! command -v python3 &> /dev/null; then
        missing+=("python3")
    fi

    # pip
    if ! command -v pip3 &> /dev/null && ! python3 -m pip --version &> /dev/null; then
        missing+=("python3-pip")
    fi

    # venv
    if ! python3 -c "import venv" &> /dev/null; then
        missing+=("python3-venv")
    fi

    # GTK4 (para interface gráfica)
    if ! python3 -c "import gi; gi.require_version('Gtk', '4.0')" &> /dev/null 2>&1; then
        missing+=("python3-gi" "gir1.2-gtk-4.0")
    fi

    # Adwaita
    if ! python3 -c "import gi; gi.require_version('Adw', '1')" &> /dev/null 2>&1; then
        missing+=("libadwaita-1-dev" "gir1.2-adw-1")
    fi

    echo "${missing[@]}"
}

# Instalar dependências do sistema
install_system_deps() {
    log_step "A verificar dependências do sistema..."

    local missing=$(check_system_deps)

    if [ -n "$missing" ]; then
        log_warn "Dependências em falta: $missing"
        log_step "A instalar dependências do sistema (requer sudo)..."

        sudo apt update
        sudo apt install -y $missing python3-gi-cairo

        log_info "Dependências do sistema instaladas."
    else
        log_info "Todas as dependências do sistema estão instaladas."
    fi
}

# Verificar/criar ambiente virtual
check_venv() {
    if [ ! -d "$VENV_DIR" ]; then
        return 1
    fi

    if [ ! -f "$PYTHON" ]; then
        return 1
    fi

    return 0
}

# Criar ambiente virtual
create_venv() {
    log_step "A criar ambiente virtual Python..."
    python3 -m venv "$VENV_DIR"

    # Upgrade pip
    "$PIP" install --upgrade pip

    log_info "Ambiente virtual criado."
}

# Instalar dependências Python
install_python_deps() {
    log_step "A instalar dependências Python..."

    if [ -f "$SCRIPT_DIR/requirements.txt" ]; then
        "$PIP" install -r "$SCRIPT_DIR/requirements.txt"
    else
        # Instalar dependências mínimas
        "$PIP" install PyYAML psutil duckduckgo-search requests beautifulsoup4
    fi

    log_info "Dependências Python instaladas."
}

# Criar diretórios de dados
create_data_dirs() {
    log_step "A criar diretórios de dados..."

    mkdir -p "$DATA_DIR/reasoning"
    mkdir -p "$DATA_DIR/blocked_ips"
    mkdir -p "$SCRIPT_DIR/logs"
    mkdir -p "$MODELS_DIR"

    # Inicializar ficheiro de IPs bloqueados
    if [ ! -f "$DATA_DIR/blocked_ips/blocked.txt" ]; then
        echo "{}" > "$DATA_DIR/blocked_ips/blocked.txt"
    fi

    log_info "Diretórios criados."
}

# Verificar modelo LLM
check_llm_model() {
    local model_found=false

    # Verificar modelos comuns
    for model in "mistral-7b-instruct-v0.2.Q4_K_M.gguf" "phi-2.Q4_K_M.gguf" "tinyllama-1.1b-chat-v1.0.Q4_K_M.gguf"; do
        if [ -f "$MODELS_DIR/$model" ]; then
            log_info "Modelo encontrado: $model"
            model_found=true
            break
        fi
    done

    if [ "$model_found" = false ]; then
        log_warn "Nenhum modelo LLM encontrado."
        echo ""
        echo -e "${YELLOW}Para instalar um modelo (opcional):${NC}"
        echo ""
        echo "  # Mistral 7B (~4GB RAM) - Recomendado para 8GB"
        echo "  cd $MODELS_DIR"
        echo "  wget https://huggingface.co/TheBloke/Mistral-7B-Instruct-v0.2-GGUF/resolve/main/mistral-7b-instruct-v0.2.Q4_K_M.gguf"
        echo ""
        echo "  # Phi-2 (~1.6GB RAM) - Para sistemas com menos memória"
        echo "  wget https://huggingface.co/TheBloke/phi-2-GGUF/resolve/main/phi-2.Q4_K_M.gguf"
        echo ""
        echo "  # TinyLlama (~700MB RAM) - Modelo mais leve"
        echo "  wget https://huggingface.co/TheBloke/TinyLlama-1.1B-Chat-v1.0-GGUF/resolve/main/tinyllama-1.1b-chat-v1.0.Q4_K_M.gguf"
        echo ""
        log_info "O Guardian funcionará em modo simulado sem modelo."
    fi
}

# Verificar sistema completo
check_system() {
    echo ""
    log_step "A verificar sistema..."
    echo ""

    # RAM
    local ram_kb=$(grep MemTotal /proc/meminfo | awk '{print $2}')
    local ram_gb=$(echo "scale=1; $ram_kb / 1024 / 1024" | bc)
    local ram_avail_kb=$(grep MemAvailable /proc/meminfo | awk '{print $2}')
    local ram_avail_gb=$(echo "scale=1; $ram_avail_kb / 1024 / 1024" | bc)

    echo -e "RAM Total:      ${GREEN}${ram_gb} GB${NC}"
    echo -e "RAM Disponível: ${GREEN}${ram_avail_gb} GB${NC}"

    if (( $(echo "$ram_gb < 8" | bc -l) )); then
        log_warn "Sistema com menos de 8GB RAM. Use modelos mais pequenos."
    fi

    # CPU
    local cpu_count=$(nproc)
    echo -e "CPUs:           ${GREEN}${cpu_count}${NC}"

    # Disco
    local disk_avail=$(df -h "$SCRIPT_DIR" | awk 'NR==2 {print $4}')
    echo -e "Disco Livre:    ${GREEN}${disk_avail}${NC}"

    echo ""

    # Python
    local python_version=$(python3 --version 2>&1)
    echo -e "Python:         ${GREEN}${python_version}${NC}"

    # GTK
    if python3 -c "import gi; gi.require_version('Gtk', '4.0')" &> /dev/null 2>&1; then
        echo -e "GTK4:           ${GREEN}Instalado${NC}"
    else
        echo -e "GTK4:           ${RED}Não instalado${NC}"
    fi

    # Adwaita
    if python3 -c "import gi; gi.require_version('Adw', '1')" &> /dev/null 2>&1; then
        echo -e "Adwaita:        ${GREEN}Instalado${NC}"
    else
        echo -e "Adwaita:        ${RED}Não instalado${NC}"
    fi

    echo ""

    # Modelo LLM
    check_llm_model

    echo ""
}

# Instalação completa
full_install() {
    show_banner

    log_info "A iniciar instalação do Guardian..."
    echo ""

    check_os
    install_system_deps

    if ! check_venv; then
        create_venv
    fi

    install_python_deps
    create_data_dirs

    echo ""
    log_info "Instalação concluída!"
    check_llm_model
}

# Verificar se instalação é necessária
needs_install() {
    # Verificar venv
    if ! check_venv; then
        return 0
    fi

    # Verificar dependências Python básicas
    if ! "$PYTHON" -c "import yaml" &> /dev/null 2>&1; then
        return 0
    fi

    # Verificar diretórios de dados
    if [ ! -d "$DATA_DIR/reasoning" ] || [ ! -d "$DATA_DIR/blocked_ips" ]; then
        return 0
    fi

    return 1
}

# Executar Guardian
run_guardian() {
    local mode="$1"

    cd "$SCRIPT_DIR"

    case "$mode" in
        "--cli"|"-c")
            log_info "A iniciar Guardian em modo terminal..."
            exec "$PYTHON" main.py --cli
            ;;
        "--check"|"-k")
            check_system
            ;;
        *)
            # Verificar se GTK está disponível
            if "$PYTHON" -c "import gi; gi.require_version('Gtk', '4.0'); gi.require_version('Adw', '1')" &> /dev/null 2>&1; then
                log_info "A iniciar Guardian com interface gráfica..."
                exec "$PYTHON" main.py
            else
                log_warn "GTK4/Adwaita não disponível. A iniciar em modo terminal..."
                exec "$PYTHON" main.py --cli
            fi
            ;;
    esac
}

# Mostrar ajuda
show_help() {
    show_banner
    echo "Uso: ./guardian [OPÇÃO]"
    echo ""
    echo "Opções:"
    echo "  (sem opção)     Inicia interface gráfica (ou terminal se GTK não disponível)"
    echo "  --cli, -c       Inicia em modo terminal"
    echo "  --check, -k     Verifica requisitos do sistema"
    echo "  --install, -i   Força reinstalação completa"
    echo "  --help, -h      Mostra esta ajuda"
    echo ""
    echo "Exemplos:"
    echo "  ./guardian              # Interface gráfica"
    echo "  ./guardian --cli        # Modo terminal"
    echo "  ./guardian --check      # Verificar sistema"
    echo ""
}

# Main
main() {
    case "$1" in
        "--help"|"-h")
            show_help
            exit 0
            ;;
        "--install"|"-i")
            full_install
            exit 0
            ;;
        "--check"|"-k")
            show_banner
            check_system
            exit 0
            ;;
    esac

    # Verificar se precisa instalar
    if needs_install; then
        show_banner
        log_warn "Guardian não está completamente instalado."
        echo ""
        read -p "Deseja instalar agora? [S/n] " -n 1 -r
        echo ""

        if [[ $REPLY =~ ^[Nn]$ ]]; then
            log_error "Instalação cancelada."
            exit 1
        fi

        full_install
        echo ""
    fi

    # Executar
    run_guardian "$1"
}

# Executar main
main "$@"
