#!/usr/bin/env bash
#
# Guardian - Agente LLM Offline para Ubuntu
# Executável principal que verifica, instala e executa
#
# Uso:
#   ./guardian           # Interface gráfica (default)
#   ./guardian --cli     # Modo terminal
#   ./guardian --check   # Verificar sistema
#   ./guardian --install # Forçar reinstalação
#

set -e

# Cores para output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Diretório do script
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV_DIR="$SCRIPT_DIR/venv"
PYTHON="$VENV_DIR/bin/python"
PIP="$VENV_DIR/bin/pip"
DATA_DIR="$SCRIPT_DIR/data"
MODELS_DIR="$HOME/.local/share/guardian/models"

